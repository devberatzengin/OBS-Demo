# Copy this file to .env (git-ignored) and fill in the values.
# Read by docker compose and by the backend (spring.config.import in application.properties).

OBS_DB_URL=jdbc:postgresql://localhost:55050/obs_db
OBS_DB_NAME=obs_db
OBS_DB_USER=obs_user
# An existing postgres_data volume keeps the password it was created with (obs_password).
# Either keep that value or recreate the volume with: docker compose down -v
OBS_DB_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
OBS_JWT_SECRET=

OBS_CORS_ALLOWED_ORIGINS=http://localhost:5173
